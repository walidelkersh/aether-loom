@page "/"

<PageTitle>Aether Loom — Play the Math</PageTitle>

<main class="game-page @(_isBonus ? "bonus-mode" : "")">
    <header class="masthead">
        <a class="wordmark" href="./" aria-label="Aether Loom home"><span class="mark">AL</span><span>Walid Elkersh <small>game mathematics portfolio</small></span></a>
        <nav aria-label="Project links">
            <button @onclick="OpenRules">Pays &amp; rules</button>
            <a href="https://github.com/walidelkersh/aether-loom/blob/main/docs/PAR-sheet.pdf" target="_blank">PAR sheet</a>
            <a href="https://github.com/walidelkersh/aether-loom" target="_blank">Source</a>
        </nav>
    </header>

    <section class="cabinet-shell">
        <div class="title-lockup">
            <p>AN ORIGINAL 243-WAYS GAME</p>
            <h1><span>AETHER</span> LOOM</h1>
            <div class="title-rule"><i></i><b>A WORKSHOP OF LIGHT &amp; CHANCE</b><i></i></div>
        </div>

        <div class="tension-ladder" aria-label="Tension state @_displayStage">
            @foreach (var stage in Enum.GetValues<TensionState>())
            {
                <div class="tension-step @((int)stage <= (int)_displayStage ? "active" : "") @((int)stage == (int)_displayStage ? "current" : "")">
                    <small>@(_isBonus ? "FREE SPIN STAGE" : "TENSION") @((int)stage + 1)</small><strong>@stage</strong><span>@_configuration.StageMultiplier(stage).ToString("0.##")× <em>in feature</em></span>
                </div>
            }
        </div>

        <div class="machine-card">
            <div class="machine-toolbar">
                <div class="reel-status"><span class="status-lamp"></span><strong>@(_showInspector ? CurrentReelSet : _isBonus ? "Weave Ascending" : "243 ways")</strong><small>@(_showInspector ? "C# model v" + _configuration.Version : "Left to right")</small></div>
                <div class="mode-switch" role="group" aria-label="Display mode">
                    <button class="@(!_showInspector ? "active" : "")" @onclick="() => _showInspector = false" aria-pressed="@(!_showInspector)">Cabinet</button>
                    <button class="@(_showInspector ? "active" : "")" @onclick="() => _showInspector = true" aria-pressed="@_showInspector">Analysis</button>
                </div>
            </div>

            @if (_preview)
            {
                <div class="preview-label" role="status">FEATURE PREVIEW · REPLAY SEED 42 · NO WAGER OR BALANCE CHANGES</div>
            }

            @if (_featureBanner is not null)
            {
                <div class="feature-banner" role="status">@_featureBanner</div>
            }

            @if (!_showInspector)
            {
                <div class="reel-bezel">
                    <div class="reel-frame @(_rolling ? "is-spinning" : "")" aria-busy="@_rolling">
                        @for (var reel = 0; reel < 5; reel++)
                        {
                            var reelIndex = reel;
                            <div class="reel @(reel < _settled ? "settled" : "rolling")" style="--delay: @(reel * 55)ms">
                                @for (var row = 0; row < 3; row++)
                                {
                                    var symbol = _grid[row, reel];
                                    <div class="symbol symbol-@ArtClass(symbol) @(IsWinning(row, reelIndex) ? "winner" : "")" aria-label="@SymbolName(symbol)">
                                        <span class="symbol-art art-@ArtClass(symbol)" aria-hidden="true"></span>
                                        <small>@SymbolName(symbol)</small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <section class="analysis-view" aria-label="Developer math">
                    <div class="analysis-left">
                        <p class="analysis-kicker">RESOLVED OUTCOME</p>
                        <div class="analysis-grid">
                            @for (var row = 0; row < 3; row++)
                            {
                                @for (var reel = 0; reel < 5; reel++)
                                {
                                    var symbol = _grid[row, reel];
                                    <span class="mini-symbol art-@ArtClass(symbol)" title="@SymbolName(symbol)"></span>
                                }
                            }
                        </div>
                        <dl class="live-state">
                            <div><dt>Reel set</dt><dd>@CurrentReelSet</dd></div>
                            <div><dt>Stops</dt><dd>@StopIndices</dd></div>
                            <div><dt>Paid state / next spin</dt><dd>@(_currentBase?.StateBefore.ToString() ?? _state.ToString()) → @_state</dd></div>
                            <div><dt>Sparks / multiplier</dt><dd>@(_currentSpin?.ScatterCount.ToString() ?? "—") / @(_currentSpin?.StageMultiplier.ToString("0.##") ?? "1")×</dd></div>
                        </dl>
                    </div>
                    <div class="analysis-right">
                        <p class="analysis-kicker">EXACT LONG-RUN MODEL · v@_configuration.Version</p>
                        <div class="rtp-row"><span>Base ways</span><i style="--value:@(_theory.BaseRtp * 100)%"></i><strong>@_theory.BaseRtp.ToString("P4")</strong></div>
                        <div class="rtp-row"><span>Feature</span><i style="--value:@(_theory.FeatureRtp * 100)%"></i><strong>@_theory.FeatureRtp.ToString("P4")</strong></div>
                        <div class="rtp-total"><span>Total theoretical RTP</span><strong>@_theory.TotalRtp.ToString("P6")</strong></div>
                        <div class="analysis-metrics">
                            <div><small>Feature entry</small><strong>1 in @((1 / _theory.FeatureTriggerProbability).ToString("0.00"))</strong></div>
                            <div><small>Base hit rate</small><strong>@_theory.BaseHitProbability.ToString("P4")</strong></div>
                            <div><small>Current award</small><strong>@_lastAward.ToString("0.00") cr</strong></div>
                            <div><small>Next paid spin entry</small><strong>@NextEntryProbability.ToString("P4")</strong></div>
                        </div>
                        <p class="inspector-note">Long-run RTP averages the three tension states. Next-spin entry is conditional on @_state. Both come from the configured strips.</p>
                        <div class="session-strip"><span>Paid spins <b>@_sessionSpins</b></span><span>Session return <b>@(_sessionWager > 0 ? (_sessionPayout / _sessionWager).ToString("P2") : "—")</b></span></div>
                        <p class="inspector-note">Session return is observed, not theoretical. Previews are excluded.</p>
                    </div>
                </section>
            }

            <div class="win-readout" role="status" aria-live="polite"><span>@_message</span><strong>@_lastAward.ToString("0.00##") <small>credits</small></strong></div>
            @if (!_rolling && _currentSpin?.Wins.Count > 0)
            {
                <div class="win-lines" aria-label="Winning ways">
                    @foreach (var win in _currentSpin.Wins)
                    {
                        <span><i class="pay-art art-@ArtClass(win.Symbol)"></i>@win.Ways ways · @win.ReelsMatched reels <b>@win.Award(_currentSpin.Bet, _currentSpin.StageMultiplier).ToString("0.00##") cr</b></span>
                    }
                </div>
            }

            <div class="controls">
                <div class="credit-block"><span>Fictional credit</span><strong>@_balance.ToString("0.00##")</strong></div>
                <div class="credit-block win-block"><span>Win</span><strong>@_lastAward.ToString("0.00")</strong></div>
                <div class="bet-control"><button @onclick="DecreaseBet" disabled="@_spinning" aria-label="Decrease bet">−</button><span><small>BET</small><strong>@_bet.ToString("0.00")</strong></span><button @onclick="IncreaseBet" disabled="@_spinning" aria-label="Increase bet">+</button></div>
                <button class="spin-button" aria-label="Spin" @onclick="Spin" disabled="@(_spinning || _balance < _bet)"><span>@(_spinning ? _isBonus ? "FREE SPINS" : "WEAVING" : "SPIN")</span><small>@(_spinning ? "Please wait" : "Space to spin")</small></button>
            </div>
            <div class="utility-bar">
                <button @onclick="ToggleSound" aria-pressed="@_sound">Sound @(_sound ? "on" : "off")</button>
                <button @onclick="() => _quick = !_quick" aria-pressed="@_quick">Quick @(_quick ? "on" : "off")</button>
                <button @onclick="PreviewFeature" disabled="@_spinning">@(_previewComplete ? "Replay feature preview" : "Preview feature")</button>
                <button @onclick="OpenRules">How to play</button>
            </div>
            @if (_balance < _bet)
            {
                <button class="reset-credits" @onclick="ResetCredits">Reset fictional credits</button>
            }
        </div>

        <section class="rule-strip">
            <article><span>01</span><h2>TIGHTEN</h2><p>Exactly two Sparks raise the persistent tension state.</p></article>
            <article><span>02</span><h2>TRIGGER</h2><p>Three Sparks award seven free spins at the state you earned.</p></article>
            <article><span>03</span><h2>ASCEND</h2><p>Two feature Sparks raise the multiplier and add a spin, up to 12.</p></article>
        </section>
        @if (_showInspector && _history.Count > 0)
        {
            <details class="round-history"><summary>Last @_history.Count paid rounds</summary><div class="table-scroll"><table><thead><tr><th>Round</th><th>Bet</th><th>Base</th><th>Feature</th><th>Tension</th></tr></thead><tbody>
                @foreach (var round in _history.Reverse())
                {
                    <tr><td>@round.Number</td><td>@round.Bet.ToString("0.00")</td><td>@round.Base.ToString("0.00##")</td><td>@round.Feature.ToString("0.00##")</td><td>@round.Before → @round.After</td></tr>
                }
            </tbody></table></div></details>
        }
    </section>

    <footer class="project-foot"><span>Fictional credits only · no wagering</span><a href="https://walidelkersh.vercel.app/projects/aether-loom" target="_blank">Case study ↗</a></footer>

    @if (_showPays)
    {
        <div class="modal-backdrop" @onclick="CloseRules">
            <section class="pays-modal" role="dialog" aria-modal="true" aria-labelledby="pays-title" tabindex="-1" @onclick:stopPropagation="true">
                <header><div><small>GAME RULES</small><h2 id="pays-title">Pays &amp; feature</h2></div><button @onclick="CloseRules" aria-label="Close pays and rules">×</button></header>
                <div class="pays-body">
                    <table><thead><tr><th>Symbol</th><th>3 reels</th><th>4 reels</th><th>5 reels</th></tr></thead><tbody>
                        @foreach (var symbol in _configuration.Paytable.PayingSymbols)
                        {
                            <tr><td><span class="pay-art art-@ArtClass(symbol)"></span>@SymbolName(symbol)</td><td>@_configuration.Paytable.Get(symbol, 3).ToString("0.##")×</td><td>@_configuration.Paytable.Get(symbol, 4).ToString("0.##")×</td><td>@_configuration.Paytable.Get(symbol, 5).ToString("0.##")×</td></tr>
                        }
                    </tbody></table>
                    <div class="rules-copy"><h3>243 ways</h3><p>Wins start on reel 1 and continue across adjacent reels. Pays are per way, multiplied by the total bet. Different symbol wins add; only the longest match of each pays.</p><h3>Wild &amp; Spark</h3><p>Wild substitutes for regular symbols. Spark has no cash pay. Neither appears twice in one reel window; reel 1 has no Wild.</p><h3>Tension</h3><p>Exactly two Sparks raise tension. Zero lowers it, one holds it, and an Overdrive paid spin vents to Rest. The ladder multipliers apply only in the feature.</p><h3>Weave Ascending</h3><p>Three or more Sparks award seven free spins. The feature inherits tension. Two or more Sparks advance the stage and add one spin, with a 12-spin maximum. At Overdrive, extra spins keep the same multiplier.</p></div>
                </div>
            </section>
        </div>
    }
</main>
